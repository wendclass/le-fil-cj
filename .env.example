# ==============================================================================
# Le Fil du bureau CJ - Variables d'environnement
# Ne jamais commiter les clés secrètes ni les valeurs de production.
# ==============================================================================

# URL de l'instance Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Clé publique anonyme (utilisée côté navigateur)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Clé Secrète de Service Supabase (SERVEUR & SCRIPTS D'AMORÇAGE UNIQUEMENT)
# Ne jamais préfixer par NEXT_PUBLIC_ ni exposer au client.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# URL publique du site (utilisée pour les redirections OAuth et les invitations)
# En local : http://localhost:3000
# En production Vercel : https://le-fil-cj.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Adresses e-mail Google des deux planificateurs initiaux (séparées par une virgule)
INITIAL_PLANNER_EMAILS=planificateur1@gmail.com,planificateur2@gmail.com

# ==============================================================================
# Phase 3 : Notifications Web Push VAPID & Cron des rappels
# ==============================================================================
# Générer les clés avec : npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BEl62iXXXXX...
VAPID_PUBLIC_KEY=BEl62iXXXXX...
VAPID_PRIVATE_KEY=xxxxxxxx...
VAPID_SUBJECT=mailto:contact@club-cj.org

# Jeton secret pour l'endpoint cron de rappels (/api/cron/reminders)
CRON_SECRET=votre_secret_aleatoire_ici
